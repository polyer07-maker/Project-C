# Secret pentru semnarea sesiunilor (obligatoriu în producție).
# Generează-l cu: openssl rand -base64 32
AUTH_SECRET=

# URL-ul public al aplicației, folosit de Auth.js pentru callback-uri.
# În dezvoltare poate rămâne http://localhost:3000
AUTH_URL=http://localhost:3000

# Conectarea cu Gmail (Google OAuth).
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application)
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Contul demo (fără Google). Valori: on / off.
# Implicit este activ doar câtă vreme Google OAuth nu este configurat.
DEMO_LOGIN=

# Opțional: reformularea răspunsurilor agentului de către un model de limbaj.
# Fără cheie, agentul funcționează complet, doar cu răspunsurile calculate.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Pentru un provider compatibil cu API-ul OpenAI (Azure, OpenRouter, Ollama etc.)
OPENAI_BASE_URL=

# Locația bazei de date SQLite (implicit ./data/app.db)
DATABASE_PATH=
